# Copiar a .env.local para desarrollo; nunca incluir valores reales en Git.
AZURE_STORAGE_ACCOUNT=nombrecuenta
AZURE_STORAGE_CONTAINER=comprobantes
# En Azure: secreto de Container Apps. En local: valor aleatorio de al menos 32 caracteres.
DEMO_TOKEN=
# Solo si se usa identidad administrada asignada por el usuario:
# AZURE_CLIENT_ID=
