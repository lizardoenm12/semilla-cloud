# Copiar a .env.local solo para probar cloud en el equipo; nunca subir secretos.
AZURE_STORAGE_ACCOUNT=stclouddevlizardo01
AZURE_STORAGE_CONTAINER=comprobantes
AZURE_KEY_VAULT_NAME=kv-cloud-lizardo-dev
AZURE_KEY_VAULT_PROBE_SECRET=prueba-conexion
# Token de acceso a la demo, generado privadamente; 32+ caracteres.
DEMO_TOKEN=
# En local: az login. No poner AZURE_CLIENT_ID de la identidad para simular su uso.
# En Container Apps: vincular id-cloud-app-dev y configurar su clientId:
# AZURE_CLIENT_ID=

# Opcional: respaldar adjuntos de operaciones en Azure al cargarlos.
# ATTACHMENT_STORAGE=azure

# Inicio de sesión: mantener local hasta disponer del registro Entra.
AUTH_MODE=local
# AUTH_MODE=entra
# AUTH_TENANT_ID=
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# AUTH_BASE_URL=http://localhost:3010
# Solo el oid del propietario original puede recuperar los negocios locales previos.
# AUTH_LEGACY_OWNER_OBJECT_ID=

# Google es la alternativa de acceso elegida; Azure mantiene los datos y servicios.
# AUTH_MODE=google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_BASE_URL=http://localhost:3010
# Sub verificado del propietario, nunca correo ni primer visitante:
# AUTH_LEGACY_GOOGLE_SUB=

# Fuente de operaciones y sesiones; pruebas usan SQLite aislado.
DATABASE_PROVIDER=sqlite
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://usuario:clave@servidor.postgres.database.azure.com/negocios
# TLS del servidor se valida automáticamente. No agregar sslmode a la URL.
