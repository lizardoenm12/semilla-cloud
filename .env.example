# Copiar a .env.local solo para probar cloud en el equipo; nunca subir secretos.
AZURE_STORAGE_ACCOUNT=stclouddevlizardo01
AZURE_STORAGE_CONTAINER=comprobantes
AZURE_KEY_VAULT_NAME=kv-cloud-lizardo-dev
AZURE_KEY_VAULT_PROBE_SECRET=prueba-conexion
# Token de acceso a la demo, generado privadamente; 32+ caracteres.
DEMO_TOKEN=
# En local: az login. No poner AZURE_CLIENT_ID de la identidad para simular su uso.
# En Container Apps: vincular id-cloud-app-dev y configurar su clientId:
# AZURE_CLIENT_ID=

# Opcional: respaldar adjuntos de operaciones en Azure al cargarlos.
# ATTACHMENT_STORAGE=azure
